{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="text-center mb-5">
    <h1>Bienvenue</h1>
    <p class="lead text-muted">Système de gestion de commandes</p>
</div>

<div class="row mt-5">
    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-body text-center p-5">
                <div style="font-size: 3rem; color: #1976d2;">🛒</div>
                <h3 class="mt-3">Passer une commande</h3>
                <p class="text-muted">Sélectionnez vos produits et validez votre commande</p>
                <a href="{{ path('commande_passer') }}" class="btn btn-primary mt-3">Commencer</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-body text-center p-5">
                <div style="font-size: 3rem; color: #1976d2;">📋</div>
                <h3 class="mt-3">Mes commandes</h3>
                <p class="text-muted">Consultez l'historique de vos commandes</p>
                <a href="{{ path('commande_list') }}" class="btn btn-primary mt-3">Voir</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
