{% extends 'base.html.twig' %}

{% block title %}Passer une commande{% endblock %}

{% block body %}
<h1>Passer une commande</h1>

<form method="post" action="{{ path('commande_valider') }}">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Produit</th>
                <th>Catégorie</th>
                <th>Prix unitaire</th>
                <th>Stock disponible</th>
                <th>Quantité</th>
                <th>Sous-total</th>
            </tr>
        </thead>
        <tbody>
            {% for produit in produits %}
            <tr>
                <td>{{ produit.libelle }}</td>
                <td><span class="badge bg-info text-dark">{{ produit.categorie }}</span></td>
                <td class="fw-bold text-primary">{{ produit.prix|number_format(0, ',', ' ') }} FCFA</td>
                <td>{{ produit.qteStock }}</td>
                <td>
                    <input type="number" 
                           name="quantities[{{ produit.id }}]" 
                           min="0" 
                           max="{{ produit.qteStock }}" 
                           value="0" 
                           class="form-control qty-input" 
                           data-prix="{{ produit.prix }}"
                           data-id="{{ produit.id }}"
                           style="width: 80px;">
                </td>
                <td class="fw-bold text-success" id="subtotal-{{ produit.id }}">0 FCFA</td>
            </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5" class="text-end"><h5 class="mb-0">Total:</h5></td>
                <td><h5 class="mb-0 text-primary" id="total">0 FCFA</h5></td>
            </tr>
        </tfoot>
    </table>
    
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Valider la commande</button>
    </div>
</form>

<script>
const inputs = document.querySelectorAll('.qty-input');
const totalEl = document.getElementById('total');

function formatNumber(num) {
    return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
}

function updateTotal() {
    let total = 0;
    inputs.forEach(input => {
        const qty = parseInt(input.value) || 0;
        const prix = parseFloat(input.dataset.prix);
        const subtotal = qty * prix;
        total += subtotal;
        
        const subtotalEl = document.getElementById('subtotal-' + input.dataset.id);
        subtotalEl.textContent = formatNumber(subtotal) + ' FCFA';
    });
    totalEl.textContent = formatNumber(total) + ' FCFA';
}

inputs.forEach(input => {
    input.addEventListener('input', updateTotal);
});
</script>
{% endblock %}
